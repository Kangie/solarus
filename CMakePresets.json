{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos",
      "displayName": "macOS",
      "description": "Ninja project for macOS",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "Qt6_DIR": "/opt/homebrew/opt/qt/lib/cmake/Qt6",
        "SOLARUS_FETCHCONTENT": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows",
      "description": "Visual Studio project for Windows",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.7.2/msvc2022_64/lib/cmake/Qt6",
        "SOLARUS_FETCHCONTENT": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux",
      "description": "Makefile for Linux",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "SOLARUS_FETCHCONTENT": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-i18n",
      "displayName": "Update translations",
      "configurePreset": "macos",
      "description": "Update .ts files (Qt translations)",
      "targets": ["update_translations"],
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS",
      "configurePreset": "macos",
      "description": "Release build with Ninja for macOS",
      "targets": ["solarus-launcher"],
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows",
      "configurePreset": "windows",
      "description": "Release build with Visual Studio for Windows",
      "targets": ["solarus-launcher"],
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux",
      "configurePreset": "linux",
      "description": "Release build for Linux",
      "targets": ["solarus-launcher"],
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "packagePresets": [
    {
      "name": "macos",
      "displayName": "macOS",
      "configurePreset": "macos",
      "description": "DMG packaging for macOS",
      "generators": ["DragNDrop"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "macos",
      "displayName": "macOS",
      "steps": [
        {
          "type": "configure",
          "name": "macos"
        },
        {
          "type": "build",
          "name": "macos"
        },
        {
          "type": "package",
          "name": "macos"
        }
      ]
    }
  ]
}
