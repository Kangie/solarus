{
  "version": 6,
  "include": ["base.json"],
  "configurePresets": [
    {
      "name": "macos",
      "displayName": "macOS",
      "description": "Ninja project for macOS",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "Qt6_DIR": "/opt/homebrew/opt/qt/lib/cmake/Qt6",
        "SOLARUS_FETCHCONTENT": true,
        "DMG_SCRIPT": false
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos",
      "displayName": "macOS",
      "configurePreset": "macos",
      "description": "Release build with Ninja for macOS",
      "targets": ["solarus-launcher"],
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-i18n",
      "displayName": "Update translations",
      "configurePreset": "macos",
      "description": "Update .ts files (Qt translations)",
      "targets": ["update_translations"],
      "configuration": "Release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "packagePresets": [
    {
      "name": "macos",
      "displayName": "macOS",
      "configurePreset": "macos",
      "description": "DMG packaging for macOS",
      "generators": ["DragNDrop"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "macos",
      "displayName": "macOS",
      "steps": [
        {
          "type": "configure",
          "name": "macos"
        },
        {
          "type": "build",
          "name": "macos"
        },
        {
          "type": "package",
          "name": "macos"
        }
      ]
    }
  ]
}
